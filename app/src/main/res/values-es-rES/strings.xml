    <!-- Location permission dialog -->
    <string name="permission_location_title">Se requiere permiso de ubicación</string>
    <string name="permission_location_body">Road Trip Radar necesita acceder a tu ubicación para mostrar dónde estás en el mapa. Se recomienda la ubicación precisa para obtener la mejor exactitud, pero la ubicación aproximada también funcionará. Toca \"Conceder permiso\" para continuar o \"Salir\" para cerrar la aplicación.</string>
    <string name="permission_grant">Conceder permiso</string>
    <string name="permission_location_denied_title">Ubicación obligatoria</string>
    <string name="permission_location_denied_body">Road Trip Radar está diseñada para mostrar el área que te rodea mientras conduces, por lo que no puede funcionar sin acceso a la ubicación. La aplicación se cerrará ahora. Puedes habilitar el acceso a la ubicación en Ajustes del sistema y volver a abrir la aplicación.</string>
