    <!-- Tutorial: MAP group -->
    <string name="tutorial_map_welcome_title">Te damos la bienvenida a Road Trip Radar</string>
    <string name="tutorial_map_welcome_body">Un recorrido rápido por los controles del mapa. Pellizca para acercar o alejar, arrastra con dos dedos hacia arriba o hacia abajo para inclinar el mapa y gira dos dedos para rotarlo.</string>
    <string name="tutorial_map_speed_title">Velocímetro</string>
    <string name="tutorial_map_speed_body">Tu velocidad actual, mostrada cuando el GPS tiene señal. Cambia entre km/h y mph en el menú de ajustes del sistema.</string>
    <string name="tutorial_map_compass_title">Brújula</string>
    <string name="tutorial_map_compass_body">Toca una vez para fijar el mapa con el norte hacia arriba. Toca otra vez para girar el mapa y que siga tu rumbo.</string>
    <string name="tutorial_map_drop_pin_title">Colocar un pin</string>
    <string name="tutorial_map_drop_pin_body">Mantén pulsado en cualquier parte del mapa para colocar un pin y navegar hacia él.</string>
    <string name="tutorial_map_zoom_out_title">Alejar</string>
    <string name="tutorial_map_zoom_out_body">Toca para alejar. También puedes pellizcar el mapa con dos dedos.</string>
    <string name="tutorial_map_zoom_in_title">Acercar</string>
    <string name="tutorial_map_zoom_in_body">Toca para acercar. También puedes separar dos dedos sobre el mapa.</string>
    <string name="tutorial_map_weather_title">Radar meteorológico</string>
    <string name="tutorial_map_weather_body">Toca para reproducir o pausar la animación del radar. Mantén pulsado para apagar el radar por completo.</string>
    <string name="tutorial_map_menu_title">Menú de acciones rápidas</string>
    <string name="tutorial_map_menu_body">Abre el panel de acciones rápidas con ajustes, temas y puntos de interés.</string>
    <!-- Tutorial: MENU_MAIN group -->
    <string name="tutorial_menu_weather_toggle_title">Radar meteorológico</string>
    <string name="tutorial_menu_weather_toggle_body">Activa o desactiva la superposición del radar meteorológico.</string>
    <string name="tutorial_menu_north_up_title">Norte arriba</string>
    <string name="tutorial_menu_north_up_body">Fija el mapa para que el norte esté siempre arriba o deja que gire para seguir tu rumbo.</string>
    <string name="tutorial_menu_nearby_places_title">Lugares cercanos</string>
    <string name="tutorial_menu_nearby_places_body">Elige qué categorías de puntos de interés (gasolina, comida, alojamiento, etc.) cargar en el mapa.</string>
    <string name="tutorial_menu_location_search_title">Búsqueda de ubicación</string>
    <string name="tutorial_menu_location_search_body">Busca una dirección o un lugar dentro del área visible del mapa.</string>
    <string name="tutorial_menu_submenu_map_title">Submenú de mapa</string>
    <string name="tutorial_menu_submenu_map_body">Elige un tema de mapa y ajusta configuraciones relacionadas con el mapa, como el desplazamiento del centro.</string>
    <string name="tutorial_menu_submenu_weather_title">Submenú del tiempo</string>
    <string name="tutorial_menu_submenu_weather_body">Activa o desactiva el widget de viento/temperatura, la leyenda del radar y la línea de tiempo, y ajusta la opacidad y las unidades del radar.</string>
    <string name="tutorial_menu_submenu_system_title">Submenú del sistema</string>
    <string name="tutorial_menu_submenu_system_body">Cambia el idioma, los tamaños de los widgets, las unidades, el comportamiento de la pantalla y restablece los valores predeterminados.</string>
    <string name="tutorial_menu_submenu_help_title">Ayuda &amp; información</string>
    <string name="tutorial_menu_submenu_help_body">Encuentra la documentación, los términos y condiciones, el registro de cambios y vuelve a reproducir este tutorial.</string>
