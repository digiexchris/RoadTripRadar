    <!-- Location permission dialog -->
    <string name="permission_location_title">Je vyžadováno oprávnění k poloze</string>
    <string name="permission_location_body">Road Trip Radar potřebuje přístup k vaší poloze, aby na mapě ukázal, kde se nacházíte. Pro nejlepší přesnost doporučujeme přesnou polohu, ale bude fungovat i přibližná poloha. Klepněte na Udělit oprávnění a pokračujte, nebo aplikaci ukončete klepnutím na Ukončit.</string>
    <string name="permission_grant">Udělit oprávnění</string>
    <string name="permission_location_denied_title">Poloha je vyžadována</string>
    <string name="permission_location_denied_body">Road Trip Radar je navržen tak, aby při jízdě zobrazoval oblast kolem vás, takže bez přístupu k poloze nemůže fungovat. Aplikace se nyní ukončí. Přístup k poloze můžete povolit v systémovém Nastavení a poté aplikaci znovu spustit.</string>
