    <!-- Tutorial: MAP group -->
    <string name="tutorial_map_welcome_title">Vítejte v aplikaci Road Trip Radar</string>
    <string name="tutorial_map_welcome_body">Krátká prohlídka ovládání mapy. Přiblížení proveďte sevřením prstů, tažením dvěma prsty nahoru nebo dolů mapu nakloňte a otáčením dvěma prsty ji otočte.</string>
    <string name="tutorial_map_speed_title">Rychloměr</string>
    <string name="tutorial_map_speed_body">Vaše aktuální rychlost, zobrazená, když má GPS signál. Mezi km/h a mph můžete přepínat v nabídce Nastavení systému.</string>
    <string name="tutorial_map_compass_title">Kompas</string>
    <string name="tutorial_map_compass_body">Klepnutím jednou uzamknete mapu se severem nahoře. Klepněte znovu a mapa se bude otáčet podle vašeho směru jízdy.</string>
    <string name="tutorial_map_drop_pin_title">Přidat špendlík</string>
    <string name="tutorial_map_drop_pin_body">Klepněte a podržte kdekoli na mapě, aby se umístil špendlík a zahájila se navigace k němu.</string>
    <string name="tutorial_map_zoom_out_title">Oddálit</string>
    <string name="tutorial_map_zoom_out_body">Klepnutím oddálíte. Můžete také sevřít mapu dvěma prsty.</string>
    <string name="tutorial_map_zoom_in_title">Přiblížit</string>
    <string name="tutorial_map_zoom_in_body">Klepnutím přiblížíte. Můžete také na mapě roztáhnout dva prsty od sebe.</string>
    <string name="tutorial_map_weather_title">Meteoradar</string>
    <string name="tutorial_map_weather_body">Klepnutím přehrajete nebo pozastavíte animaci radaru. Klepnutím a podržením radar úplně vypnete.</string>
    <string name="tutorial_map_menu_title">Nabídka rychlých akcí</string>
    <string name="tutorial_map_menu_body">Otevře panel rychlých akcí s nastavením, motivy a body zájmu.</string>
    <!-- Tutorial: MENU_MAIN group -->
    <string name="tutorial_menu_weather_toggle_title">Meteoradar</string>
    <string name="tutorial_menu_weather_toggle_body">Zapne nebo vypne vrstvu meteoradaru.</string>
    <string name="tutorial_menu_north_up_title">Sever nahoře</string>
    <string name="tutorial_menu_north_up_body">Uzamkne mapu tak, aby byl sever vždy nahoře, nebo ji nechá otáčet podle vašeho směru jízdy.</string>
    <string name="tutorial_menu_nearby_places_title">Místa v okolí</string>
    <string name="tutorial_menu_nearby_places_body">Vyberte, které kategorie bodů zájmu (čerpací stanice, jídlo, ubytování atd.) se mají načíst na mapu.</string>
    <string name="tutorial_menu_location_search_title">Hledání polohy</string>
    <string name="tutorial_menu_location_search_body">Vyhledejte adresu nebo název místa v rámci viditelné oblasti mapy.</string>
    <string name="tutorial_menu_submenu_map_title">Podnabídka mapy</string>
    <string name="tutorial_menu_submenu_map_body">Vyberte motiv mapy a upravte nastavení související s mapou, například posun středu.</string>
    <string name="tutorial_menu_submenu_weather_title">Podnabídka počasí</string>
    <string name="tutorial_menu_submenu_weather_body">Zapínejte a vypínejte widget vítr/teplota, legendu radaru a časovou osu a upravte krytí radaru a jednotky.</string>
    <string name="tutorial_menu_submenu_system_title">Podnabídka systému</string>
    <string name="tutorial_menu_submenu_system_body">Změňte jazyk, velikosti widgetů, jednotky, chování obrazovky a obnovte výchozí nastavení.</string>
    <string name="tutorial_menu_submenu_help_title">Nápověda &amp; informace</string>
    <string name="tutorial_menu_submenu_help_body">Najdete zde dokumentaci, smluvní podmínky, seznam změn a možnost znovu spustit tento tutoriál.</string>
