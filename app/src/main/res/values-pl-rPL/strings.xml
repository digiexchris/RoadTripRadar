    <!-- Tutorial: MAP group -->
    <string name="tutorial_map_welcome_title">Witamy w Road Trip Radar</string>
    <string name="tutorial_map_welcome_body">Szybki przegląd elementów sterowania mapą. Uszczypnij, aby przybliżyć, przeciągnij dwoma palcami w górę lub w dół, aby pochylić mapę, i obróć dwoma palcami, aby ją obrócić.</string>
    <string name="tutorial_map_speed_title">Prędkościomierz</string>
    <string name="tutorial_map_speed_body">Twoja bieżąca prędkość, wyświetlana, gdy GPS ma ustaloną pozycję. Przełączaj między km/h i mph w menu ustawień systemowych.</string>
    <string name="tutorial_map_compass_title">Kompas</string>
    <string name="tutorial_map_compass_body">Dotknij raz, aby zablokować mapę z północą u góry. Dotknij ponownie, aby obrócić mapę zgodnie z kierunkiem jazdy.</string>
    <string name="tutorial_map_drop_pin_title">Upuść pinezkę</string>
    <string name="tutorial_map_drop_pin_body">Dotknij i przytrzymaj gdziekolwiek na mapie, aby dodać punkt drogi. Wybierz, gdzie znajduje się trasa — rozpocznij się przed ostatnim przystankiem lub zakończeniem.</string>
    <string name="tutorial_map_zoom_out_title">Pomniejsz</string>
    <string name="tutorial_map_zoom_out_body">Dotknij, aby pomniejszyć. Możesz też uszczypnąć mapę dwoma palcami.</string>
    <string name="tutorial_map_zoom_in_title">Powiększ</string>
    <string name="tutorial_map_zoom_in_body">Dotknij, aby powiększyć. Możesz też rozsunąć dwa palce na mapie.</string>
    <string name="tutorial_map_weather_title">Radar pogodowy</string>
    <string name="tutorial_map_weather_body">Dotknij, aby odtworzyć lub wstrzymać animację radaru. Dotknij i przytrzymaj, aby całkowicie wyłączyć radar.</string>
    <string name="tutorial_map_menu_title">Menu szybkich działań</string>
    <string name="tutorial_map_menu_body">Otwiera panel szybkich działań z ustawieniami, motywami i punktami zainteresowania.</string>
    <!-- Tutorial: MAP_SETTINGS group -->
    <string name="tutorial_map_setting_theme_title">Motyw mapy</string>
    <string name="tutorial_map_setting_theme_body">Wybierz styl mapy. Otwórz selektor motywu, aby przełączać się pomiędzy wbudowanymi stylami lub importować niestandardowe.</string>
    <string name="tutorial_map_setting_units_title">Jednostki</string>
    <string name="tutorial_map_setting_units_body">Przełącz się między metryczną (km, m) i imperialną (mile, yardy). Ma wpływ na prędkość, odległość i progi punktu drogi.</string>
    <string name="tutorial_map_setting_center_offset_portrait_title">Przesunięcie środka mapy (pionowe)</string>
    <string name="tutorial_map_setting_center_offset_portrait_body">Jak daleko na ekranie mapa jest zakotwiczona, gdy jest ustawiona pionowo. Wyższe wartości pozostawiają więcej pustego miejsca na górze, przydatne, gdy widżety nawigacyjne tłumi dół.</string>
    <string name="tutorial_map_setting_center_offset_landscape_title">Przesunięcie środka mapy (poziomo)</string>
    <string name="tutorial_map_setting_center_offset_landscape_body">Ten sam pomysł co offset portretowy, zastosowany, gdy telefon jest na boku.</string>
    <string name="tutorial_map_setting_poi_opacity_title">Przezroczystość ikon</string>
    <string name="tutorial_map_setting_poi_opacity_body">Zanikanie ikony w pobliżu lub poza nią nie pokrywa mapy. 0%% całkowicie je ukrywa.</string>
    <string name="tutorial_map_setting_auto_advance_toggle_title">Automatyczne przenoszenie</string>
    <string name="tutorial_map_setting_auto_advance_toggle_body">Po włączeniu aktywny punkt drogi rozwija się automatycznie, gdy osiągniesz każdy przystanek. Wyłącz ręcznie za pomocą długiego przytrzymania skrótu na przyciskach powiększenia.</string>
    <string name="tutorial_map_setting_auto_advance_threshold_title">Odległość awansu</string>
    <string name="tutorial_map_setting_auto_advance_threshold_body">Jak blisko musisz być do punktu drogi, aby automatycznie przejść do ognia. Zakres 25–500 m.</string>
    <!-- Tutorial: ROUTE_EDITOR group -->
    <string name="tutorial_route_nav_widget_title">Edytuj trasę</string>
    <string name="tutorial_route_nav_widget_body">Dotknij widżetu nawigacyjnego, aby otworzyć listę zatrzymań. Przeciągnij, aby zmienić kolejność, oznaczyć stan zatrzymania, usunąć punkty drogi lub wyczyścić całą trasę.</string>
    <string name="tutorial_route_long_press_out_title">Krok wstecz punkt nawigacyjny</string>
    <string name="tutorial_route_long_press_out_body">Przytrzymaj przycisk - aby poprzedni punkt nawigacyjny był aktywny. Widżet nav wskazuje dowolny punkt nawigacyjny.</string>
    <string name="tutorial_route_long_press_in_title">Przejdź do następnego punktu trasy</string>
    <string name="tutorial_route_long_press_in_body">Naciśnij i przytrzymaj przycisk +, aby następny punkt nawigacyjny był aktywny. Auto-postęp robi to dla Ciebie, gdy się zamkniesz, ale możesz wykonać ręcznie w każdej chwili. Przełącz auto-zaawansowanie i dostosuj próg odległości w menu → Mapa.</string>
    <!-- Tutorial: MENU_MAIN group -->
    <string name="tutorial_menu_weather_toggle_title">Radar pogodowy</string>
    <string name="tutorial_menu_weather_toggle_body">Włącz lub wyłącz nakładkę radaru pogodowego.</string>
    <string name="tutorial_menu_north_up_title">Północ u góry</string>
    <string name="tutorial_menu_north_up_body">Zablokuj mapę tak, aby północ zawsze była u góry, albo pozwól jej obracać się zgodnie z kierunkiem jazdy.</string>
    <string name="tutorial_menu_nearby_places_title">Miejsca w pobliżu</string>
    <string name="tutorial_menu_nearby_places_body">Wybierz kategorie punktów zainteresowania (paliwo, jedzenie, noclegi itp.), które mają być wczytywane na mapę.</string>
    <string name="tutorial_menu_location_search_title">Wyszukiwanie lokalizacji</string>
    <string name="tutorial_menu_location_search_body">Szukaj adresu lub nazwy miejsca w widocznym obszarze mapy.</string>
    <string name="tutorial_menu_submenu_map_title">Podmenu mapy</string>
    <string name="tutorial_menu_submenu_map_body">Wybierz motyw mapy i dostosuj ustawienia związane z mapą, takie jak przesunięcie środka.</string>
    <string name="tutorial_menu_submenu_weather_title">Podmenu pogody</string>
    <string name="tutorial_menu_submenu_weather_body">Włączaj lub wyłączaj widżet wiatru/temperatury, legendę radaru i oś czasu oraz dostosowuj krycie radaru i jednostki.</string>
    <string name="tutorial_menu_submenu_system_title">Podmenu systemowe</string>
    <string name="tutorial_menu_submenu_system_body">Zmień język, rozmiary widżetów, jednostki, zachowanie ekranu i przywróć ustawienia domyślne.</string>
    <string name="tutorial_menu_submenu_help_title">Pomoc &amp; informacje</string>
    <string name="tutorial_menu_submenu_help_body">Znajdź dokumentację, regulamin, dziennik zmian i odtwórz ponownie ten samouczek.</string>
