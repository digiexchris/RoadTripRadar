    <!-- Location permission dialog -->
    <string name="permission_location_title">Wymagane uprawnienie do lokalizacji</string>
    <string name="permission_location_body">Road Trip Radar potrzebuje dostępu do Twojej lokalizacji, aby pokazać, gdzie jesteś na mapie. Aby uzyskać najlepszą dokładność, zalecana jest dokładna lokalizacja, ale przybliżona lokalizacja także będzie działać. Dotknij opcji Udziel uprawnienia, aby kontynuować, lub Zakończ, aby wyjść z aplikacji.</string>
    <string name="permission_grant">Przyznaj uprawnienie</string>
    <string name="permission_location_denied_title">Wymagana lokalizacja</string>
    <string name="permission_location_denied_body">Road Trip Radar został zaprojektowany tak, aby pokazywać obszar wokół Ciebie podczas jazdy, więc nie może działać bez dostępu do lokalizacji. Aplikacja zostanie teraz zamknięta. Możesz włączyć dostęp do lokalizacji w systemowych Ustawieniach i uruchomić aplikację ponownie.</string>
