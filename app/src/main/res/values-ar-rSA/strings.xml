    <!-- Tutorial: MAP group -->
    <string name="tutorial_map_welcome_title">مرحبًا بك في Road Trip Radar</string>
    <string name="tutorial_map_welcome_body">جولة سريعة في عناصر التحكم بالخريطة. قرّب بإصبعيك للتكبير، واسحب بإصبعين لأعلى أو لأسفل لإمالة الخريطة، ولفّ إصبعين لتدويرها.</string>
    <string name="tutorial_map_speed_title">مقياس السرعة</string>
    <string name="tutorial_map_speed_body">سرعتك الحالية، وتظهر عند توفر إشارة GPS. بدّل بين كم/س وmph من قائمة إعدادات النظام.</string>
    <string name="tutorial_map_compass_title">البوصلة</string>
    <string name="tutorial_map_compass_body">اضغط مرة واحدة لقفل الخريطة بحيث يكون الشمال للأعلى. اضغط مرة أخرى لتدوير الخريطة بحيث تتبع اتجاهك.</string>
    <string name="tutorial_map_drop_pin_title">إسقاط دبوس</string>
    <string name="tutorial_map_drop_pin_body">اضغط مطولًا في أي مكان على الخريطة لإسقاط دبوس والتنقل نحوه.</string>
    <string name="tutorial_map_zoom_out_title">تصغير</string>
    <string name="tutorial_map_zoom_out_body">اضغط للتصغير. يمكنك أيضًا ضم إصبعين على الخريطة.</string>
    <string name="tutorial_map_zoom_in_title">تكبير</string>
    <string name="tutorial_map_zoom_in_body">اضغط للتكبير. يمكنك أيضًا مباعدة إصبعين على الخريطة.</string>
    <string name="tutorial_map_weather_title">رادار الطقس</string>
    <string name="tutorial_map_weather_body">اضغط لتشغيل أو إيقاف مؤقت لتحريك الرادار. اضغط مطولًا لإيقاف الرادار تمامًا.</string>
    <string name="tutorial_map_menu_title">قائمة الإجراءات السريعة</string>
    <string name="tutorial_map_menu_body">تفتح درج الإجراءات السريعة الذي يحتوي على الإعدادات والسمات ونقاط الاهتمام.</string>
    <!-- Tutorial: MENU_MAIN group -->
    <string name="tutorial_menu_weather_toggle_title">رادار الطقس</string>
    <string name="tutorial_menu_weather_toggle_body">شغّل أو أوقف طبقة رادار الطقس.</string>
    <string name="tutorial_menu_north_up_title">الشمال للأعلى</string>
    <string name="tutorial_menu_north_up_body">اقفل الخريطة بحيث يكون الشمال دائمًا للأعلى، أو اتركها تدور لتتبع اتجاهك.</string>
    <string name="tutorial_menu_nearby_places_title">أماكن قريبة</string>
    <string name="tutorial_menu_nearby_places_body">اختر فئات نقاط الاهتمام التي تريد تحميلها على الخريطة (وقود، طعام، إقامة، إلخ).</string>
    <string name="tutorial_menu_location_search_title">البحث عن موقع</string>
    <string name="tutorial_menu_location_search_body">ابحث عن عنوان أو اسم مكان ضمن منطقة الخريطة الظاهرة.</string>
    <string name="tutorial_menu_submenu_map_title">القائمة الفرعية للخريطة</string>
    <string name="tutorial_menu_submenu_map_body">اختر سمة للخريطة وعدّل الإعدادات المتعلقة بها مثل إزاحة المركز.</string>
    <string name="tutorial_menu_submenu_weather_title">القائمة الفرعية للطقس</string>
    <string name="tutorial_menu_submenu_weather_body">بدّل عنصر الرياح/الحرارة، ومفتاح الرادار، والخط الزمني، واضبط عتامة الرادار ووحداته.</string>
    <string name="tutorial_menu_submenu_system_title">القائمة الفرعية للنظام</string>
    <string name="tutorial_menu_submenu_system_body">غيّر اللغة وأحجام العناصر والوحدات وسلوك الشاشة، وأعد التعيين إلى الإعدادات الافتراضية.</string>
    <string name="tutorial_menu_submenu_help_title">المساعدة والمعلومات</string>
    <string name="tutorial_menu_submenu_help_body">اعثر على الوثائق، والأحكام والشروط، وسجل التغييرات، وأعد تشغيل هذا البرنامج التعليمي.</string>
