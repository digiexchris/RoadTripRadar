    <!-- Tutorial: MAP group -->
    <string name="tutorial_map_welcome_title">Tere tulemast rakendusse Road Trip Radar</string>
    <string name="tutorial_map_welcome_body">Lühike ülevaade kaardi juhtnuppudest. Näpista suumimiseks, lohista kahe sõrmega üles või alla, et kaarti kallutada, ning pööra kahe sõrmega, et kaarti pöörata.</string>
    <string name="tutorial_map_speed_title">Spidomeeter</string>
    <string name="tutorial_map_speed_body">Sinu praegune kiirus, mida kuvatakse siis, kui GPS-signaal on olemas. Vaheta km/h ja mph vahel süsteemiseadete menüüs.</string>
    <string name="tutorial_map_compass_title">Kompass</string>
    <string name="tutorial_map_compass_body">Puuduta üks kord, et lukustada kaart asendisse, kus põhi on üleval. Puuduta uuesti, et kaart pöörduks sinu liikumissuuna järgi.</string>
    <string name="tutorial_map_drop_pin_title">Aseta nööpnõel</string>
    <string name="tutorial_map_drop_pin_body">Tap and hold anywhere on the map to add a waypoint. Choose where it goes in your route — start, before the final stop, or end.</string>
    <string name="tutorial_map_zoom_out_title">Suumi välja</string>
    <string name="tutorial_map_zoom_out_body">Puuduta suumimiseks välja. Võid kaarti ka kahe sõrmega kokku näpistada.</string>
    <string name="tutorial_map_zoom_in_title">Suumi sisse</string>
    <string name="tutorial_map_zoom_in_body">Puuduta suumimiseks sisse. Võid ka kaardil kahte sõrme teineteisest eemale liigutada.</string>
    <string name="tutorial_map_weather_title">Ilmaradar</string>
    <string name="tutorial_map_weather_body">Puuduta, et radari animatsioon käivitada või peatada. Puuduta ja hoia, et radar täielikult välja lülitada.</string>
    <string name="tutorial_map_menu_title">Kiirtoimingute menüü</string>
    <string name="tutorial_map_menu_body">Avab kiirtoimingute paneeli seadete, teemade ja huvipunktidega.</string>
    <!-- Tutorial: MAP_SETTINGS group -->
    <string name="tutorial_map_setting_theme_title">Map theme</string>
    <string name="tutorial_map_setting_theme_body">Pick the map style. Open the theme selector to switch between built-in styles or import a custom one.</string>
    <string name="tutorial_map_setting_units_title">Units</string>
    <string name="tutorial_map_setting_units_body">Switch between metric (km, m) and imperial (miles, yards). Affects speed, distance, and waypoint thresholds.</string>
    <string name="tutorial_map_setting_center_offset_portrait_title">Map center offset (portrait)</string>
    <string name="tutorial_map_setting_center_offset_portrait_body">How far down the screen the map is anchored when held vertically. Higher values leave more empty space at the top, useful when nav widgets crowd the bottom.</string>
    <string name="tutorial_map_setting_center_offset_landscape_title">Map center offset (landscape)</string>
    <string name="tutorial_map_setting_center_offset_landscape_body">Same idea as the portrait offset, applied when your phone is sideways.</string>
    <string name="tutorial_map_setting_poi_opacity_title">Places icon opacity</string>
    <string name="tutorial_map_setting_poi_opacity_body">Fade nearby place icons in or out so they don\'t cover the map. 0%% hides them entirely.</string>
    <string name="tutorial_map_setting_auto_advance_toggle_title">Auto-advance</string>
    <string name="tutorial_map_setting_auto_advance_toggle_body">When on, the active waypoint advances automatically as you reach each stop. Turn off to step manually using the long-press shortcut on the zoom buttons.</string>
    <string name="tutorial_map_setting_auto_advance_threshold_title">Advance distance</string>
    <string name="tutorial_map_setting_auto_advance_threshold_body">How close you need to be to a waypoint for auto-advance to fire. Range 25–500 m.</string>
    <!-- Tutorial: ROUTE_EDITOR group -->
    <string name="tutorial_route_nav_widget_title">Edit your route</string>
    <string name="tutorial_route_nav_widget_body">Tap the nav widget to open the stops list. Drag to reorder, mark a stop active, remove waypoints, or clear the whole route.</string>
    <string name="tutorial_route_long_press_out_title">Step back a waypoint</string>
    <string name="tutorial_route_long_press_out_body">Long-press the – button to make the previous waypoint active. The nav widget points to whichever waypoint is active.</string>
    <string name="tutorial_route_long_press_in_title">Advance to the next waypoint</string>
    <string name="tutorial_route_long_press_in_body">Long-press the + button to make the next waypoint active. Auto-advance does this for you when you get close, but you can step manually any time. Toggle auto-advance and tune the distance threshold in Menu → Map.</string>
    <!-- Tutorial: MENU_MAIN group -->
    <string name="tutorial_menu_weather_toggle_title">Ilmaradar</string>
    <string name="tutorial_menu_weather_toggle_body">Lülita ilmaradari kiht sisse või välja.</string>
    <string name="tutorial_menu_north_up_title">Põhi üleval</string>
    <string name="tutorial_menu_north_up_body">Lukusta kaart nii, et põhi on alati üleval, või lase sel pöörduda sinu suuna järgi.</string>
    <string name="tutorial_menu_nearby_places_title">Läheduses olevad kohad</string>
    <string name="tutorial_menu_nearby_places_body">Vali, milliseid huvipunktide kategooriaid (kütus, toit, majutus jne) kaardile laadida.</string>
    <string name="tutorial_menu_location_search_title">Asukoha otsing</string>
    <string name="tutorial_menu_location_search_body">Otsi aadressi või koha nime nähtava kaardiala piires.</string>
    <string name="tutorial_menu_submenu_map_title">Kaardi alammenüü</string>
    <string name="tutorial_menu_submenu_map_body">Vali kaardi teema ja kohanda kaardiga seotud seadeid, näiteks keskme nihet.</string>
    <string name="tutorial_menu_submenu_weather_title">Ilma alammenüü</string>
    <string name="tutorial_menu_submenu_weather_body">Lülita tuule/temperatuuri vidin, radari legend ja ajajoon sisse või välja ning kohanda radari läbipaistmatust ja ühikuid.</string>
    <string name="tutorial_menu_submenu_system_title">Süsteemi alammenüü</string>
    <string name="tutorial_menu_submenu_system_body">Muuda keelt, vidinate suurusi, ühikuid, ekraani käitumist ja lähtesta vaikeväärtused.</string>
    <string name="tutorial_menu_submenu_help_title">Abi &amp; teave</string>
    <string name="tutorial_menu_submenu_help_body">Leia dokumentatsioon, tingimused, muudatuste logi ja esita see juhend uuesti.</string>
