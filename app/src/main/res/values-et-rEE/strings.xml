    <!-- Location permission dialog -->
    <string name="permission_location_title">Asukoha luba on vajalik</string>
    <string name="permission_location_body">Road Trip Radar vajab juurdepääsu sinu asukohale, et näidata kaardil, kus sa asud. Parima täpsuse jaoks on soovitatav täpne asukoht, kuid töötab ka ligikaudne asukoht. Jätkamiseks puuduta valikut \"Anna luba\" või rakendusest väljumiseks \"Välju\".</string>
