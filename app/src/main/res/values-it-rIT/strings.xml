    <!-- Location permission dialog -->
    <string name="permission_location_title">Autorizzazione alla posizione richiesta</string>
    <string name="permission_location_body">Road Trip Radar ha bisogno di accedere alla tua posizione per mostrare dove ti trovi sulla mappa. La posizione precisa è consigliata per la massima accuratezza, ma anche la posizione approssimativa funzionerà. Tocca Concedi autorizzazione per continuare oppure Esci per chiudere l\'app.</string>
    <string name="permission_grant">Concedi autorizzazione</string>
    <string name="permission_location_denied_title">Posizione richiesta</string>
    <string name="permission_location_denied_body">Road Trip Radar è progettata per mostrare l\'area intorno a te mentre guidi, quindi non può funzionare senza l\'accesso alla posizione. L\'app ora si chiuderà. Puoi abilitare l\'accesso alla posizione nelle Impostazioni di sistema e avviare di nuovo l\'app.</string>
