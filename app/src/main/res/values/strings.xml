    <!-- Tutorial: MAP group -->
    <string name="tutorial_map_welcome_title">Welcome to Road Trip Radar</string>
    <string name="tutorial_map_welcome_body">A quick tour of the map controls. Pinch to zoom, drag with two fingers up or down to tilt the map, and rotate two fingers to rotate it.</string>
    <string name="tutorial_map_speed_title">Speedometer</string>
    <string name="tutorial_map_speed_body">Your current speed, shown when GPS has a fix. Switch between km/h and mph in the System settings menu.</string>
    <string name="tutorial_map_compass_title">Compass</string>
    <string name="tutorial_map_compass_body">Tap once to lock the map to North up. Tap again to rotate the map to follow your bearing.</string>
    <string name="tutorial_map_drop_pin_title">Drop a Pin</string>
    <string name="tutorial_map_drop_pin_body">Tap and hold anywhere on the map to add a waypoint. Choose where it goes in your route — start, before the final stop, or end.</string>
    <string name="tutorial_map_zoom_out_title">Zoom Out</string>
    <string name="tutorial_map_zoom_out_body">Tap to zoom out. You can also pinch the map with two fingers.</string>
    <string name="tutorial_map_zoom_in_title">Zoom In</string>
    <string name="tutorial_map_zoom_in_body">Tap to zoom in. You can also spread two fingers apart on the map.</string>
    <string name="tutorial_map_weather_title">Weather Radar</string>
    <string name="tutorial_map_weather_body">Tap to play or pause the radar animation. Tap and hold to turn the radar off entirely.</string>
    <string name="tutorial_map_menu_title">Quick Actions Menu</string>
    <string name="tutorial_map_menu_body">Opens the quick actions drawer with settings, themes, and points of interest.</string>

    <!-- Tutorial: MAP_SETTINGS group -->
    <string name="tutorial_map_setting_theme_title">Map theme</string>
    <string name="tutorial_map_setting_theme_body">Pick the map style. Open the theme selector to switch between built-in styles or import a custom one.</string>
    <string name="tutorial_map_setting_units_title">Units</string>
    <string name="tutorial_map_setting_units_body">Switch between metric (km, m) and imperial (miles, yards). Affects speed, distance, and waypoint thresholds.</string>
    <string name="tutorial_map_setting_center_offset_portrait_title">Map center offset (portrait)</string>
    <string name="tutorial_map_setting_center_offset_portrait_body">How far down the screen the map is anchored when held vertically. Higher values leave more empty space at the top, useful when nav widgets crowd the bottom.</string>
    <string name="tutorial_map_setting_center_offset_landscape_title">Map center offset (landscape)</string>
    <string name="tutorial_map_setting_center_offset_landscape_body">Same idea as the portrait offset, applied when your phone is sideways.</string>
    <string name="tutorial_map_setting_center_offset_car_title">Map center offset (car)</string>
    <string name="tutorial_map_setting_center_offset_car_body">How far down the screen the map is anchored when displayed on an Android Auto head unit. Independent from the phone\'s portrait and landscape offsets, so you can tune each surface for its viewport.</string>
    <string name="tutorial_map_setting_poi_opacity_title">Places icon opacity</string>
    <string name="tutorial_map_setting_poi_opacity_body">Fade nearby place icons in or out so they don\'t cover the map. 0%% hides them entirely.</string>
    <string name="tutorial_map_setting_auto_advance_toggle_title">Auto-advance</string>
    <string name="tutorial_map_setting_auto_advance_toggle_body">When on, the active waypoint advances automatically as you reach each stop. Turn off to step manually using the long-press shortcut on the zoom buttons.</string>
    <string name="tutorial_map_setting_auto_advance_threshold_title">Advance distance</string>
    <string name="tutorial_map_setting_auto_advance_threshold_body">How close you need to be to a waypoint for auto-advance to fire. Range 25–500 m.</string>

    <!-- Tutorial: ROUTE_EDITOR group -->
    <string name="tutorial_route_nav_widget_title">Edit your route</string>
    <string name="tutorial_route_nav_widget_body">Tap the nav widget to open the stops list. Drag to reorder, mark a stop active, remove waypoints, or clear the whole route.</string>
    <string name="tutorial_route_long_press_out_title">Step back a waypoint</string>
    <string name="tutorial_route_long_press_out_body">Long-press the – button to make the previous waypoint active. The nav widget points to whichever waypoint is active.</string>
    <string name="tutorial_route_long_press_in_title">Advance to the next waypoint</string>
    <string name="tutorial_route_long_press_in_body">Long-press the + button to make the next waypoint active. Auto-advance does this for you when you get close, but you can step manually any time. Toggle auto-advance and tune the distance threshold in Menu → Map.</string>

    <!-- Tutorial: MENU_MAIN group -->
    <string name="tutorial_menu_weather_toggle_title">Weather Radar</string>
    <string name="tutorial_menu_weather_toggle_body">Turn the weather radar overlay on or off.</string>
    <string name="tutorial_menu_north_up_title">North Up</string>
    <string name="tutorial_menu_north_up_body">Lock the map so North is always up, or let it rotate to follow your bearing.</string>
    <string name="tutorial_menu_nearby_places_title">Nearby Places</string>
    <string name="tutorial_menu_nearby_places_body">Pick which categories of points of interest (gas, food, lodging, etc.) to load onto the map.</string>
    <string name="tutorial_menu_location_search_title">Location Search</string>
    <string name="tutorial_menu_location_search_body">Search for an address or place name within the visible map area.</string>
    <string name="tutorial_menu_submenu_map_title">Map Submenu</string>
    <string name="tutorial_menu_submenu_map_body">Choose a map theme and tweak map-related settings like the center offset.</string>
    <string name="tutorial_menu_submenu_weather_title">Weather Submenu</string>
    <string name="tutorial_menu_submenu_weather_body">Toggle the wind/temperature widget, radar legend, and timeline, and adjust radar opacity and units.</string>
    <string name="tutorial_menu_submenu_system_title">System Submenu</string>
    <string name="tutorial_menu_submenu_system_body">Change language, widget sizes, units, screen behavior, and reset to defaults.</string>
    <string name="tutorial_menu_submenu_help_title">Help &amp; Info</string>
