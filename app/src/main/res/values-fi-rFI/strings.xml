    <!-- Location permission dialog -->
    <string name="permission_location_title">Sijaintilupa vaaditaan</string>
    <string name="permission_location_body">Road Trip Radar tarvitsee pääsyn sijaintiisi voidakseen näyttää, missä olet kartalla. Paras tarkkuus saadaan käyttämällä tarkkaa sijaintia, mutta myös likimääräinen sijainti toimii. Jatka napauttamalla Myönnä lupa tai poistu sovelluksesta napauttamalla Lopeta.</string>
