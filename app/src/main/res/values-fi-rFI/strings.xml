    <!-- Tutorial: MAP group -->
    <string name="tutorial_map_welcome_title">Tervetuloa käyttämään Road Trip Radaria</string>
    <string name="tutorial_map_welcome_body">Tässä on nopea esittely kartan hallintapainikkeista. Nipistä zoomataksesi, kallista karttaa vetämällä kahdella sormella ylös tai alas ja kierrä karttaa kiertämällä kahta sormea.</string>
    <string name="tutorial_map_speed_title">Nopeusmittari</string>
    <string name="tutorial_map_speed_body">Nykyinen nopeutesi näkyy, kun GPS-sijainti on saatavilla. Voit vaihtaa km/h- ja mph-yksiköiden välillä Järjestelmäasetukset-valikossa.</string>
    <string name="tutorial_map_compass_title">Kompassi</string>
    <string name="tutorial_map_compass_body">Napauta kerran lukitaksesi kartan pohjoinen ylhäällä -tilaan. Napauta uudelleen, niin kartta kääntyy kulkusuuntasi mukaan.</string>
    <string name="tutorial_map_drop_pin_title">Lisää neula</string>
    <string name="tutorial_map_drop_pin_body">Napauta ja pidä kiinni mihin tahansa kartalla lisätäksesi reittipisteen. Valitse mihin se menee reitilläsi — aloita ennen lopullista pysähdystä tai loppuu.</string>
    <string name="tutorial_map_zoom_out_title">Loitonna</string>
    <string name="tutorial_map_zoom_out_body">Napauta loitontaaksesi. Voit myös nipistää karttaa kahdella sormella.</string>
    <string name="tutorial_map_zoom_in_title">Lähennä</string>
    <string name="tutorial_map_zoom_in_body">Napauta lähentääksesi. Voit myös levittää kahta sormea erilleen kartalla.</string>
    <string name="tutorial_map_weather_title">Säätutka</string>
    <string name="tutorial_map_weather_body">Napauta toistaaksesi tai keskeyttääksesi tutkakuvan animaation. Pidä painettuna poistaaksesi tutkan kokonaan käytöstä.</string>
    <string name="tutorial_map_menu_title">Pikatoiminnot-valikko</string>
    <string name="tutorial_map_menu_body">Avaa pikatoimintopaneelin, jossa ovat asetukset, teemat ja kiinnostavat kohteet.</string>
    <!-- Tutorial: MAP_SETTINGS group -->
    <string name="tutorial_map_setting_theme_title">Kartta teema</string>
    <string name="tutorial_map_setting_theme_body">Valitse karttatyyli. Avaa teeman valitsin vaihtaaksesi sisäänrakennetuista tyyleistä tai tuodaksesi mukautetun tyylin.</string>
    <string name="tutorial_map_setting_units_title">Yksiköt</string>
    <string name="tutorial_map_setting_units_body">Vaihtaa metrisen (km, m) ja keisarillisen (mailia, mitat). Vaikuttaa nopeuteen, etäisyyteen ja reittipistekynnyksiin.</string>
    <string name="tutorial_map_setting_center_offset_portrait_title">Kartan keskustan siirtymä (pysty)</string>
    <string name="tutorial_map_setting_center_offset_portrait_body">Kuinka kauas ruutua kartta on ankkuroitu, kun sitä pidetään pystysuunnassa. Korkeammat arvot jättävät enemmän tyhjää tilaa yläreunassa, hyödyllinen kun nav widgetit väsyttävät alareunan.</string>
    <string name="tutorial_map_setting_center_offset_landscape_title">Kartan keskustan siirtymä (maisema)</string>
    <string name="tutorial_map_setting_center_offset_landscape_body">Sama idea kuin muotokuva offset, käytetään kun puhelin on sivusuunnassa.</string>
    <string name="tutorial_map_setting_poi_opacity_title">Paikkojen kuvakkeen läpinäkyvyys</string>
    <string name="tutorial_map_setting_poi_opacity_body">Häivytä lähistöllä olevat kuvakkeet sisään tai ulos, joten ne eivät peitä karttaa. 0%% piilottaa ne kokonaan.</string>
    <string name="tutorial_map_setting_auto_advance_toggle_title">Automaattinen Edistäminen</string>
    <string name="tutorial_map_setting_auto_advance_toggle_body">Kun olet päällä, aktiivinen reittipiste etenee automaattisesti jokaisen pysähdyksen kohdalla. Ota pois päältä astua manuaalisesti painamalla zoomauspainikkeita pitkään pikanäppäimeen.</string>
    <string name="tutorial_map_setting_auto_advance_threshold_title">Edullinen etäisyys</string>
    <string name="tutorial_map_setting_auto_advance_threshold_body">Kuinka lähellä sinun täytyy olla reittipiste, jossa auto-advance ampua. Vaihteluväli 25–500 m.</string>
    <!-- Tutorial: ROUTE_EDITOR group -->
    <string name="tutorial_route_nav_widget_title">Muokkaa reittiäsi</string>
    <string name="tutorial_route_nav_widget_body">Napauta nav-widgettiä avataksesi pysähdysluettelon. Vedä uudelleenjärjestykseen, merkitse pysähdys aktiiviseksi, poista reittipisteet tai tyhjennä koko reitti.</string>
    <string name="tutorial_route_long_press_out_title">Astu reittipiste takaisin</string>
    <string name="tutorial_route_long_press_out_body">Paina pitkään – nappia saadaksesi edellisen reittipisteen aktivoitumaan. Nav widget pisteitä kummallekin reittipisteelle on aktiivinen.</string>
    <string name="tutorial_route_long_press_in_title">Siirry seuraavaan reittipisteeseen</string>
    <string name="tutorial_route_long_press_in_body">Paina pitkään + -painiketta saadaksesi seuraavan reittipisteen käyttöön. Automaattinen edistyminen tekee tämän sinulle, kun tulet lähelle, mutta voit astua manuaalisesti milloin tahansa. Vaihda automaattisesti etukäteen ja viritä etäisyysrajaa valikossa → Kartta.</string>
    <!-- Tutorial: MENU_MAIN group -->
    <string name="tutorial_menu_weather_toggle_title">Säätutka</string>
    <string name="tutorial_menu_weather_toggle_body">Laita säätutkapeite käyttöön tai pois käytöstä.</string>
    <string name="tutorial_menu_north_up_title">Pohjoinen ylhäällä</string>
    <string name="tutorial_menu_north_up_body">Lukitse kartta niin, että pohjoinen on aina ylhäällä, tai anna sen kääntyä kulkusuuntasi mukaan.</string>
    <string name="tutorial_menu_nearby_places_title">Lähellä olevat paikat</string>
    <string name="tutorial_menu_nearby_places_body">Valitse, mitkä kiinnostavien kohteiden luokat (polttoaine, ruoka, majoitus jne.) ladataan kartalle.</string>
    <string name="tutorial_menu_location_search_title">Sijaintihaku</string>
    <string name="tutorial_menu_location_search_body">Hae osoitetta tai paikan nimeä näkyvältä kartta-alueelta.</string>
    <string name="tutorial_menu_submenu_map_title">Kartta-alivalikko</string>
    <string name="tutorial_menu_submenu_map_body">Valitse karttateema ja säädä karttaan liittyviä asetuksia, kuten keskikohdan siirtymää.</string>
    <string name="tutorial_menu_submenu_weather_title">Sää-alivalikko</string>
    <string name="tutorial_menu_submenu_weather_body">Näytä tai piilota tuuli-/lämpötilasovellusosa, tutkan selite ja aikajana sekä säädä tutkan peittävyyttä ja yksiköitä.</string>
    <string name="tutorial_menu_submenu_system_title">Järjestelmä-alivalikko</string>
    <string name="tutorial_menu_submenu_system_body">Vaihda kieli, pienoissovellusten koot, yksiköt ja näytön toiminta sekä palauta oletusasetukset.</string>
    <string name="tutorial_menu_submenu_help_title">Ohje &amp; tiedot</string>
    <string name="tutorial_menu_submenu_help_body">Löydä dokumentaatio, ehdot, muutosloki ja tämän opastuksen uudelleentoisto.</string>
