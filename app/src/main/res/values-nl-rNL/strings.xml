    <!-- Location permission dialog -->
    <string name="permission_location_title">Locatiemachtiging vereist</string>
    <string name="permission_location_body">Road Trip Radar heeft toegang tot je locatie nodig om te laten zien waar je bent op de kaart. Voor de beste nauwkeurigheid wordt een precieze locatie aanbevolen, maar een geschatte locatie werkt ook. Tik op Toestemming verlenen om door te gaan, of op Afsluiten om de app te sluiten.</string>
    <string name="permission_grant">Machtiging verlenen</string>
    <string name="permission_location_denied_title">Locatie vereist</string>
    <string name="permission_location_denied_body">Road Trip Radar is ontworpen om tijdens het rijden het gebied om je heen te tonen en kan daarom niet functioneren zonder toegang tot je locatie. De app wordt nu afgesloten. Je kunt locatietoegang inschakelen in de systeeminstellingen en de app opnieuw starten.</string>
