    <!-- Tutorial: MAP group -->
    <string name="tutorial_map_welcome_title">Welkom bij Road Trip Radar</string>
    <string name="tutorial_map_welcome_body">Een korte rondleiding door de kaartbediening. Knijp om te zoomen, sleep met twee vingers omhoog of omlaag om de kaart te kantelen en draai twee vingers om de kaart te draaien.</string>
    <string name="tutorial_map_speed_title">Snelheidsmeter</string>
    <string name="tutorial_map_speed_body">Je huidige snelheid, weergegeven wanneer GPS een fix heeft. Wissel tussen km/h en mph in het menu Systeeminstellingen.</string>
    <string name="tutorial_map_compass_title">Kompas</string>
    <string name="tutorial_map_compass_body">Tik één keer om de kaart vast te zetten met het noorden boven. Tik nogmaals om de kaart te draaien zodat die je rijrichting volgt.</string>
    <string name="tutorial_map_drop_pin_title">Pin neerzetten</string>
    <string name="tutorial_map_drop_pin_body">Tik en houd vast op de kaart om een waypoint toe te voegen. Kies waar het in je route heen gaat - start voor de laatste halte of eindigd.</string>
    <string name="tutorial_map_zoom_out_title">Uitzoomen</string>
    <string name="tutorial_map_zoom_out_body">Tik om uit te zoomen. Je kunt ook met twee vingers op de kaart knijpen.</string>
    <string name="tutorial_map_zoom_in_title">Inzoomen</string>
    <string name="tutorial_map_zoom_in_body">Tik om in te zoomen. Je kunt ook twee vingers op de kaart uit elkaar bewegen.</string>
    <string name="tutorial_map_weather_title">Weerradar</string>
    <string name="tutorial_map_weather_body">Tik om de radaranimatie af te spelen of te pauzeren. Tik en houd vast om de radar volledig uit te schakelen.</string>
    <string name="tutorial_map_menu_title">Menu Snelle acties</string>
    <string name="tutorial_map_menu_body">Opent het paneel met snelle acties met instellingen, thema\'s en interessante locaties.</string>
    <!-- Tutorial: MAP_SETTINGS group -->
    <string name="tutorial_map_setting_theme_title">Map thema</string>
    <string name="tutorial_map_setting_theme_body">Kies de kaart-stijl. Open de thema selector om te schakelen tussen ingebouwde stijlen of een aangepaste te importeren.</string>
    <string name="tutorial_map_setting_units_title">Eenheden</string>
    <string name="tutorial_map_setting_units_body">Schakelaar tussen metrisch (km, m) en imperiaal (miles, yards). Heeft invloed op snelheid, afstand en waypoint drempels.</string>
    <string name="tutorial_map_setting_center_offset_portrait_title">Kaart center offset (staand)</string>
    <string name="tutorial_map_setting_center_offset_portrait_body">Hoe ver het scherm verticaal wordt vastgehouden, is de kaart verankerd. Hogere waarden laten meer lege ruimte bovenaan, handig wanneer nav widgets de bodem overslaan.</string>
    <string name="tutorial_map_setting_center_offset_landscape_title">Kaart center offset (liggend)</string>
    <string name="tutorial_map_setting_center_offset_landscape_body">Hetzelfde idee als de portrait offset wordt toegepast wanneer de telefoon zijwaarts is.</string>
    <string name="tutorial_map_setting_poi_opacity_title">Plaatsen pictogram ondoorzichtigheid</string>
    <string name="tutorial_map_setting_poi_opacity_body">Vervaag plaatsiconen in of buiten, zodat ze niet de kaart bedekken. 0%% verbergt ze volledig.</string>
    <string name="tutorial_map_setting_auto_advance_toggle_title">Automatisch optrekken</string>
    <string name="tutorial_map_setting_auto_advance_toggle_body">Wanneer ingeschakeld, wordt het actieve waypoint automatisch verbeterd wanneer je elke stop bereikt. Schakel dit uit om handmatig te handelen met behulp van de langdruk-sneltoets op de zoomknoppen.</string>
    <string name="tutorial_map_setting_auto_advance_threshold_title">Vooraf afstand</string>
    <string name="tutorial_map_setting_auto_advance_threshold_body">Hoe dicht je moet zijn bij een waypoint om automatisch vooruit te schieten. Bereik 25-500 m.</string>
    <!-- Tutorial: ROUTE_EDITOR group -->
    <string name="tutorial_route_nav_widget_title">Route bewerken</string>
    <string name="tutorial_route_nav_widget_body">Tik op de nav-widget om de stoplijst te openen. Sleep om te rangschikken, een stop actief, verwijder waypoints of wis de hele route.</string>
    <string name="tutorial_route_long_press_out_title">Stap een waypoint terug</string>
    <string name="tutorial_route_long_press_out_body">Druk lang op de – knop om het vorige waypoint actief te maken. De nav widget wijst naar welk waypoint actief is.</string>
    <string name="tutorial_route_long_press_in_title">Verdergaan naar het volgende waypoint</string>
    <string name="tutorial_route_long_press_in_body">Druk lang op de + knop om het volgende waypoint actief te maken. Auto-Voorwaarts doet dit voor je als je dichtbij komt, maar je kunt op elk moment handmatig een stap zetten. Schakelen tussen automatisch opschieten en aanpassen van de afstand drempel in het menu → Kaart.</string>
    <!-- Tutorial: MENU_MAIN group -->
    <string name="tutorial_menu_weather_toggle_title">Weerradar</string>
    <string name="tutorial_menu_weather_toggle_body">Schakel de weerradarlaag in of uit.</string>
    <string name="tutorial_menu_north_up_title">Noorden boven</string>
    <string name="tutorial_menu_north_up_body">Zet de kaart vast zodat het noorden altijd boven is, of laat deze draaien zodat die je rijrichting volgt.</string>
    <string name="tutorial_menu_nearby_places_title">Plekken in de buurt</string>
    <string name="tutorial_menu_nearby_places_body">Kies welke categorieën interessante locaties (tankstations, eten, overnachtingen enz.) op de kaart worden geladen.</string>
    <string name="tutorial_menu_location_search_title">Locatie zoeken</string>
    <string name="tutorial_menu_location_search_body">Zoek naar een adres of plaatsnaam binnen het zichtbare kaartgebied.</string>
    <string name="tutorial_menu_submenu_map_title">Kaartsubmenu</string>
    <string name="tutorial_menu_submenu_map_body">Kies een kaartthema en pas kaartgerelateerde instellingen aan, zoals de middenverschuiving.</string>
    <string name="tutorial_menu_submenu_weather_title">Weersubmenu</string>
    <string name="tutorial_menu_submenu_weather_body">Schakel de widget voor wind/temperatuur, radarlegenda en tijdlijn in of uit, en pas de radaropaciteit en eenheden aan.</string>
    <string name="tutorial_menu_submenu_system_title">Systeemsubmenu</string>
    <string name="tutorial_menu_submenu_system_body">Wijzig taal, widgetgrootten, eenheden en schermgedrag, en herstel de standaardinstellingen.</string>
    <string name="tutorial_menu_submenu_help_title">Help &amp; info</string>
    <string name="tutorial_menu_submenu_help_body">Vind documentatie, algemene voorwaarden, de wijzigingenlijst en speel deze tutorial opnieuw af.</string>
