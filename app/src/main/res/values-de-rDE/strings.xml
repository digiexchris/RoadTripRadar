    <!-- Tutorial: MAP group -->
    <string name="tutorial_map_welcome_title">Willkommen bei Road Trip Radar</string>
    <string name="tutorial_map_welcome_body">Eine kurze Einführung in die Kartensteuerung. Zum Zoomen zwei Finger zusammen- oder auseinanderziehen, die Karte mit zwei Fingern nach oben oder unten ziehen, um sie zu neigen, und zwei Finger drehen, um sie zu rotieren.</string>
    <string name="tutorial_map_speed_title">Tachometer</string>
    <string name="tutorial_map_speed_body">Ihre aktuelle Geschwindigkeit, angezeigt, wenn ein GPS-Fix vorliegt. Zwischen km/h und mph können Sie im Menü \"Systemeinstellungen\" wechseln.</string>
    <string name="tutorial_map_compass_title">Kompass</string>
    <string name="tutorial_map_compass_body">Einmal tippen, um die Karte nach Norden auszurichten. Erneut tippen, um die Karte entsprechend Ihrer Fahrtrichtung zu drehen.</string>
    <string name="tutorial_map_drop_pin_title">Pin setzen</string>
    <string name="tutorial_map_drop_pin_body">Tippe und halte irgendwo auf der Karte, um einen Wegpunkt hinzuzufügen. Wählen Sie aus, wohin es in Ihrer Route geht — starten Sie vor der Endstation oder beenden Sie die Strecke.</string>
    <string name="tutorial_map_zoom_out_title">Herauszoomen</string>
    <string name="tutorial_map_zoom_out_body">Tippen zum Herauszoomen. Sie können die Karte auch mit zwei Fingern zusammenziehen.</string>
    <string name="tutorial_map_zoom_in_title">Hineinzoomen</string>
    <string name="tutorial_map_zoom_in_body">Tippen zum Hineinzoomen. Sie können auf der Karte auch zwei Finger auseinanderziehen.</string>
    <string name="tutorial_map_weather_title">Wetterradar</string>
    <string name="tutorial_map_weather_body">Tippen, um die Radaranimation abzuspielen oder anzuhalten. Tippen und halten, um das Radar vollständig auszuschalten.</string>
    <string name="tutorial_map_menu_title">Schnellaktionen-Menü</string>
    <string name="tutorial_map_menu_body">Öffnet die Schnellaktionen-Schublade mit Einstellungen, Designs und Sonderzielen.</string>
    <!-- Tutorial: MAP_SETTINGS group -->
    <string name="tutorial_map_setting_theme_title">Kartenthema</string>
    <string name="tutorial_map_setting_theme_body">Wählen Sie den Kartenstil. Öffnen Sie den Design-Selektor, um zwischen eingebauten Stilen zu wechseln oder einen benutzerdefinierten zu importieren.</string>
    <string name="tutorial_map_setting_units_title">Einheiten</string>
    <string name="tutorial_map_setting_units_body">Wechseln Sie zwischen Metrik (km, m) und Imperial (Meilen, Werft). Beeinflusst Sie Geschwindigkeit, Distanz und Wegpunkt.</string>
    <string name="tutorial_map_setting_center_offset_portrait_title">Kartenmittelversatz (Hochformat)</string>
    <string name="tutorial_map_setting_center_offset_portrait_body">Wie weit unten der Bildschirm ist die Karte vertikal verankert. Höhere Werte lassen mehr Leerzeichen an der oberen Stelle, nützlich wenn nav Widgets die untere Menge überfüllen.</string>
    <string name="tutorial_map_setting_center_offset_landscape_title">Kartenmittelversatz (Querformat)</string>
    <string name="tutorial_map_setting_center_offset_landscape_body">Gleiche Idee wie der Porträt-Offset, der angewendet wird, wenn Ihr Telefon seitlich ist.</string>
    <string name="tutorial_map_setting_poi_opacity_title">Orte Deckkraft des Symbols</string>
    <string name="tutorial_map_setting_poi_opacity_body">In der Nähe befindliche Ortssymbole ein- oder ausblenden, damit sie die Karte nicht bedecken. 0%% versteckt sie vollständig.</string>
    <string name="tutorial_map_setting_auto_advance_toggle_title">Automatisch vorwärts</string>
    <string name="tutorial_map_setting_auto_advance_toggle_body">Wenn aktiviert, schreitet der aktive Wegpunkt automatisch voran, während Sie jeden Stop erreichen. Schalten Sie aus, um manuell zu gehen, indem Sie die Tastenkombination auf den Zoomtasten drücken.</string>
    <string name="tutorial_map_setting_auto_advance_threshold_title">Vorwärts Distanz</string>
    <string name="tutorial_map_setting_auto_advance_threshold_body">Wie nah muss man sich an einem Wegpunkt befinden, um automatisch vorwärts zum Feuern zu gelangen. Reichweite 25–500 m.</string>
    <!-- Tutorial: ROUTE_EDITOR group -->
    <string name="tutorial_route_nav_widget_title">Route bearbeiten</string>
    <string name="tutorial_route_nav_widget_body">Tippe auf das nav Widget, um die Stopp-Liste zu öffnen. Ziehe zum Nachsetzen, markiere einen Stop aktiv, entferne Wegpunkte oder leere die ganze Strecke.</string>
    <string name="tutorial_route_long_press_out_title">Wegpunkt zurücksetzen</string>
    <string name="tutorial_route_long_press_out_body">Drücken Sie den - Knopf, um den vorherigen Wegpunkt aktiv zu machen. Das nav Widget zeigt an, welcher Wegpunkt aktiv ist.</string>
    <string name="tutorial_route_long_press_in_title">Weiter zum nächsten Wegpunkt</string>
    <string name="tutorial_route_long_press_in_body">Drücken Sie lange die + Taste, um den nächsten Wegpunkt aktiv zu machen. Automatischer Fortschritt tut dies für Sie, wenn Sie nahe kommen, aber Sie können jederzeit manuell einspringen. Automatisch vorwärts schalten und den Abstand unter Menü → Karte einstellen.</string>
    <!-- Tutorial: MENU_MAIN group -->
    <string name="tutorial_menu_weather_toggle_title">Wetterradar</string>
    <string name="tutorial_menu_weather_toggle_body">Die Wetterradar-Überlagerung ein- oder ausschalten.</string>
    <string name="tutorial_menu_north_up_title">Norden oben</string>
    <string name="tutorial_menu_north_up_body">Die Karte so fixieren, dass Norden immer oben ist, oder sie Ihrer Fahrtrichtung folgen lassen.</string>
    <string name="tutorial_menu_nearby_places_title">Orte in der Nähe</string>
    <string name="tutorial_menu_nearby_places_body">Wählen Sie aus, welche Kategorien von Sonderzielen (Tankstellen, Essen, Unterkünfte usw.) auf die Karte geladen werden sollen.</string>
    <string name="tutorial_menu_location_search_title">Standortsuche</string>
    <string name="tutorial_menu_location_search_body">Suchen Sie innerhalb des sichtbaren Kartenbereichs nach einer Adresse oder einem Ortsnamen.</string>
    <string name="tutorial_menu_submenu_map_title">Karten-Untermenü</string>
    <string name="tutorial_menu_submenu_map_body">Wählen Sie ein Kartendesign und passen Sie kartenbezogene Einstellungen wie den Mittelpunktversatz an.</string>
    <string name="tutorial_menu_submenu_weather_title">Wetter-Untermenü</string>
    <string name="tutorial_menu_submenu_weather_body">Blenden Sie das Wind-/Temperatur-Widget, die Radarlegende und die Zeitleiste ein oder aus und passen Sie Radar-Deckkraft und Einheiten an.</string>
    <string name="tutorial_menu_submenu_system_title">System-Untermenü</string>
    <string name="tutorial_menu_submenu_system_body">Sprache, Widget-Größen, Einheiten und Bildschirmverhalten ändern oder auf Standardwerte zurücksetzen.</string>
    <string name="tutorial_menu_submenu_help_title">Hilfe &amp; Info</string>
    <string name="tutorial_menu_submenu_help_body">Hier finden Sie Dokumentation, Nutzungsbedingungen, das Änderungsprotokoll und können dieses Tutorial erneut abspielen.</string>
