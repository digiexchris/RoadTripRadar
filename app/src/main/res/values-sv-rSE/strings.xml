    <!-- Location permission dialog -->
    <string name="permission_location_title">Platsbehörighet krävs</string>
    <string name="permission_location_body">Road Trip Radar behöver åtkomst till din plats för att visa var du är på kartan. Exakt plats rekommenderas för bästa noggrannhet, men ungefärlig plats fungerar också. Tryck på Ge behörighet för att fortsätta eller på Avsluta för att stänga appen.</string>
    <string name="permission_grant">Bevilja behörighet</string>
    <string name="permission_location_denied_title">Plats krävs</string>
    <string name="permission_location_denied_body">Road Trip Radar är utformad för att visa området runt dig medan du kör, så den kan inte fungera utan åtkomst till din plats. Appen kommer nu att avslutas. Du kan aktivera platsåtkomst i systemets Inställningar och starta appen igen.</string>
