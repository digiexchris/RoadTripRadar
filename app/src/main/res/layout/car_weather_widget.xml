<?xml version="1.0" encoding="utf-8"?>
<!--
  Graphical weather card overlaid on the car map surface, mirroring the phone WeatherWidget:
  temp + trend, a bearing-corrected wind arrow with an "air" badge, then wind speed↑gusts + unit.
  The `unavailable` group replaces the content when there is no snapshot yet. Colors and the
  wind arrow rotation are applied programmatically by CarWeatherWidget.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/car_weather_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/car_weather_widget_bg"
    android:backgroundTint="#00000000"
    android:paddingHorizontal="12dp"
    android:paddingVertical="8dp">

    <LinearLayout
        android:id="@+id/car_weather_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:id="@+id/car_weather_temp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="28sp"
            android:gravity="center" />

        <TextView
            android:id="@+id/car_weather_trend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="20sp"
            android:gravity="center" />

        <FrameLayout
            android:id="@+id/car_weather_wind_box"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginTop="4dp"
            android:layout_gravity="center">

            <ImageView
                android:id="@+id/car_weather_arrow"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_gravity="center"
                android:scaleType="centerInside"
                android:src="@drawable/ic_car_wind_arrow" />

            <FrameLayout
                android:id="@+id/car_weather_badge"
                android:layout_width="27dp"
                android:layout_height="27dp"
                android:layout_gravity="center"
                android:background="@drawable/car_weather_widget_bg"
                android:backgroundTint="#00000000">

                <ImageView
                    android:id="@+id/car_weather_air"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_car_wind" />
            </FrameLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/car_weather_wind_speed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="28sp"
            android:gravity="center" />

        <TextView
            android:id="@+id/car_weather_wind_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:gravity="center" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/car_weather_unavailable"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <ImageView
            android:id="@+id/car_weather_off_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:scaleType="centerInside"
            android:src="@drawable/ic_car_weather_off" />

        <TextView
            android:id="@+id/car_weather_off_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/weather_unavailable"
            android:textSize="20sp"
            android:gravity="center" />
    </LinearLayout>
</LinearLayout>