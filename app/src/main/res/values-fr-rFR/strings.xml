    <!-- Location permission dialog -->
    <string name="permission_location_title">Autorisation de localisation requise</string>
    <string name="permission_location_body">Road Trip Radar a besoin d’accéder à votre position pour afficher où vous vous trouvez sur la carte. Une position précise est recommandée pour une meilleure exactitude, mais une position approximative fonctionnera également. Appuyez sur Autoriser pour continuer, ou sur Quitter pour fermer l’application.</string>
    <string name="permission_grant">Accorder l’autorisation</string>
    <string name="permission_location_denied_title">Position requise</string>
    <string name="permission_location_denied_body">Road Trip Radar est conçu pour afficher la zone autour de vous pendant que vous conduisez, et ne peut donc pas fonctionner sans accès à la position. L’application va maintenant se fermer. Vous pouvez activer l’accès à la position dans les paramètres système et relancer l’application.</string>
