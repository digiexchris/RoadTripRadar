    <!-- Tutorial: MAP group -->
    <string name="tutorial_map_welcome_title">Welcome to Road Trip Radar</string>
    <string name="tutorial_map_welcome_body">A quick tour of the map controls. Pinch to zoom, drag with two fingers up or down to tilt the map, and rotate two fingers to rotate it.</string>
    <string name="tutorial_map_speed_title">Speedometer</string>
    <string name="tutorial_map_speed_body">Your current speed, shown when GPS has a fix. Switch between km/h and mph in the System settings menu.</string>
    <string name="tutorial_map_compass_title">Compass</string>
    <string name="tutorial_map_compass_body">Tap once to lock the map to North up. Tap again to rotate the map to follow your bearing.</string>
    <string name="tutorial_map_drop_pin_title">Drop a Pin</string>
    <string name="tutorial_map_drop_pin_body">Tap and hold anywhere on the map to drop a pin and navigate toward it.</string>
    <string name="tutorial_map_zoom_out_title">Zoom Out</string>
    <string name="tutorial_map_zoom_out_body">Tap to zoom out. You can also pinch the map with two fingers.</string>
    <string name="tutorial_map_zoom_in_title">Zoom In</string>
    <string name="tutorial_map_zoom_in_body">Tap to zoom in. You can also spread two fingers apart on the map.</string>
    <string name="tutorial_map_weather_title">Weather Radar</string>
    <string name="tutorial_map_weather_body">Tap to play or pause the radar animation. Tap and hold to turn the radar off entirely.</string>
    <string name="tutorial_map_menu_title">Quick Actions Menu</string>
    <string name="tutorial_map_menu_body">Opens the quick actions drawer with settings, themes, and points of interest.</string>
    <!-- Tutorial: MENU_MAIN group -->
    <string name="tutorial_menu_weather_toggle_title">Weather Radar</string>
    <string name="tutorial_menu_weather_toggle_body">Turn the weather radar overlay on or off.</string>
    <string name="tutorial_menu_north_up_title">North Up</string>
    <string name="tutorial_menu_north_up_body">Lock the map so North is always up, or let it rotate to follow your bearing.</string>
    <string name="tutorial_menu_nearby_places_title">Nearby Places</string>
    <string name="tutorial_menu_nearby_places_body">Pick which categories of points of interest (gas, food, lodging, etc.) to load onto the map.</string>
    <string name="tutorial_menu_location_search_title">Location Search</string>
    <string name="tutorial_menu_location_search_body">Search for an address or place name within the visible map area.</string>
    <string name="tutorial_menu_submenu_map_title">Map Submenu</string>
    <string name="tutorial_menu_submenu_map_body">Choose a map theme and tweak map-related settings like the center offset.</string>
    <string name="tutorial_menu_submenu_weather_title">Weather Submenu</string>
    <string name="tutorial_menu_submenu_weather_body">Toggle the wind/temperature widget, radar legend, and timeline, and adjust radar opacity and units.</string>
    <string name="tutorial_menu_submenu_system_title">System Submenu</string>
    <string name="tutorial_menu_submenu_system_body">Change language, widget sizes, units, screen behavior, and reset to defaults.</string>
    <string name="tutorial_menu_submenu_help_title">Help &amp; Info</string>
    <string name="tutorial_menu_submenu_help_body">Find documentation, terms and conditions, the changelog, and replay this tutorial.</string>
