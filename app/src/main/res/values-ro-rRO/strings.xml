    <!-- Location permission dialog -->
    <string name="permission_location_title">Este necesară permisiunea pentru locație</string>
    <string name="permission_location_body">Road Trip Radar are nevoie de acces la locația dvs. pentru a arăta unde vă aflați pe hartă. Locația precisă este recomandată pentru cea mai bună acuratețe, dar va funcționa și locația aproximativă. Atingeți Acordați permisiunea pentru a continua sau Ieșiți pentru a închide aplicația.</string>
    <string name="permission_grant">Acordă permisiunea</string>
    <string name="permission_location_denied_title">Locație necesară</string>
    <string name="permission_location_denied_body">Road Trip Radar este conceput pentru a afișa zona din jurul dvs. în timp ce conduceți, astfel că nu poate funcționa fără acces la locație. Aplicația se va închide acum. Puteți activa accesul la locație din Setările sistemului și lansa din nou aplicația.</string>
