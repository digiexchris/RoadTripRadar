    <!-- Tutorial: MAP group -->
    <string name="tutorial_map_welcome_title">Bine ai venit la Road Trip Radar</string>
    <string name="tutorial_map_welcome_body">Un tur rapid al comenzilor hărții. Apropie sau depărtează două degete pentru a mări sau micșora, glisează cu două degete în sus sau în jos pentru a înclina harta și rotește două degete pentru a o roti.</string>
    <string name="tutorial_map_speed_title">Vitezometru</string>
    <string name="tutorial_map_speed_body">Viteza ta curentă, afișată când GPS-ul are semnal. Comută între km/h și mph în meniul Setări sistem.</string>
    <string name="tutorial_map_compass_title">Busolă</string>
    <string name="tutorial_map_compass_body">Atinge o dată pentru a fixa harta cu nordul în sus. Atinge din nou pentru a roti harta astfel încât să urmeze direcția ta de deplasare.</string>
    <string name="tutorial_map_drop_pin_title">Plasează un pin</string>
    <string name="tutorial_map_drop_pin_body">Atingeți și țineți apăsat oriunde pe hartă pentru a adăuga un punct. Alege unde merge pe ruta ta - pornește, înainte de oprirea finală, sau sfârșit.</string>
    <string name="tutorial_map_zoom_out_title">Micșorează</string>
    <string name="tutorial_map_zoom_out_body">Atinge pentru a micșora. De asemenea, poți apropia două degete pe hartă.</string>
    <string name="tutorial_map_zoom_in_title">Mărește</string>
    <string name="tutorial_map_zoom_in_body">Atinge pentru a mări. De asemenea, poți depărta două degete pe hartă.</string>
    <string name="tutorial_map_weather_title">Radar meteo</string>
    <string name="tutorial_map_weather_body">Atinge pentru a porni sau pune pe pauză animația radarului. Atinge și ține apăsat pentru a opri complet radarul.</string>
    <string name="tutorial_map_menu_title">Meniul de acțiuni rapide</string>
    <string name="tutorial_map_menu_body">Deschide panoul de acțiuni rapide cu setări, teme și puncte de interes.</string>
    <!-- Tutorial: MAP_SETTINGS group -->
    <string name="tutorial_map_setting_theme_title">Temă hartă</string>
    <string name="tutorial_map_setting_theme_body">Alegeți stilul hărții. Deschideți selectorul de teme pentru a comuta între stilurile încorporate sau pentru a importa unul personalizat.</string>
    <string name="tutorial_map_setting_units_title">Unități</string>
    <string name="tutorial_map_setting_units_body">Comutarea între măsurători (km, m) și imperiale (mile, șantiere). Afectează viteza, distanța și pragurile de punct de plecare.</string>
    <string name="tutorial_map_setting_center_offset_portrait_title">Decalaj centru hartă (portret)</string>
    <string name="tutorial_map_setting_center_offset_portrait_body">Cât de departe ecranul harta este ancorată când este ținută vertical. Valorile mai mari lasă mai mult spațiu gol în partea de sus, folositor când nav widget-uri se ascunde în partea de jos.</string>
    <string name="tutorial_map_setting_center_offset_landscape_title">Deplasare centru hartă (peisaj)</string>
    <string name="tutorial_map_setting_center_offset_landscape_body">Aceeași idee ca și portretul offset, aplicată când telefonul se află în lateral.</string>
    <string name="tutorial_map_setting_poi_opacity_title">Plasează opacitatea pictogramei</string>
    <string name="tutorial_map_setting_poi_opacity_body">Ascundeți pictogramele din apropiere pentru a nu acoperi harta. 0%% le ascunde în întregime.</string>
    <string name="tutorial_map_setting_auto_advance_toggle_title">Avansare automată</string>
    <string name="tutorial_map_setting_auto_advance_toggle_body">Când este pornit, punctul activ avansează automat pe măsură ce ajungeți la fiecare oprire. Opriți pentru a păși manual folosind butonul de micșorare a butoanelor pentru apăsare lungă.</string>
    <string name="tutorial_map_setting_auto_advance_threshold_title">Distanță avansată</string>
    <string name="tutorial_map_setting_auto_advance_threshold_body">Cât de aproape trebuie să fiți la punctul de trecere pentru a trece automat la foc. Range 25-500 m.</string>
    <!-- Tutorial: ROUTE_EDITOR group -->
    <string name="tutorial_route_nav_widget_title">Editează ruta</string>
    <string name="tutorial_route_nav_widget_body">Apăsați widget-ul nav pentru a deschide lista de opriri. Trageți pentru a reordona, marcați o oprire activă, eliminați punctele de trecere sau ștergeți întregul rută.</string>
    <string name="tutorial_route_long_press_out_title">Pas înapoi un punct</string>
    <string name="tutorial_route_long_press_out_body">Apăsați lung butonul - pentru a activa punctul de referință. Widget-ul nav arată către oricare dintre punctele de trecere este activ.</string>
    <string name="tutorial_route_long_press_in_title">Avansează până la următorul punct</string>
    <string name="tutorial_route_long_press_in_body">Apăsați lung butonul + pentru a activa următorul punct. Progresul automat face acest lucru pentru tine atunci când te apropii dar poți face pas manual oricând. Comută avansarea automată și reglează pragul de distanță în Meniu → Hărțuri.</string>
    <!-- Tutorial: MENU_MAIN group -->
    <string name="tutorial_menu_weather_toggle_title">Radar meteo</string>
    <string name="tutorial_menu_weather_toggle_body">Activează sau dezactivează suprapunerea radarului meteo.</string>
    <string name="tutorial_menu_north_up_title">Nord în sus</string>
    <string name="tutorial_menu_north_up_body">Fixează harta astfel încât nordul să fie mereu în sus sau las-o să se rotească pentru a urma direcția ta de deplasare.</string>
    <string name="tutorial_menu_nearby_places_title">Locuri din apropiere</string>
    <string name="tutorial_menu_nearby_places_body">Alege ce categorii de puncte de interes (benzină, mâncare, cazare etc.) să fie încărcate pe hartă.</string>
    <string name="tutorial_menu_location_search_title">Căutare locație</string>
    <string name="tutorial_menu_location_search_body">Caută o adresă sau numele unui loc în zona vizibilă a hărții.</string>
    <string name="tutorial_menu_submenu_map_title">Submeniul Hartă</string>
    <string name="tutorial_menu_submenu_map_body">Alege o temă pentru hartă și ajustează setări legate de hartă, cum ar fi decalajul centrului.</string>
    <string name="tutorial_menu_submenu_weather_title">Submeniul Meteo</string>
    <string name="tutorial_menu_submenu_weather_body">Comută widgetul de vânt/temperatură, legenda radarului și cronologia și ajustează opacitatea radarului și unitățile.</string>
    <string name="tutorial_menu_submenu_system_title">Submeniul Sistem</string>
    <string name="tutorial_menu_submenu_system_body">Schimbă limba, dimensiunile widgeturilor, unitățile, comportamentul ecranului și resetează la valorile implicite.</string>
    <string name="tutorial_menu_submenu_help_title">Ajutor &amp; Informații</string>
    <string name="tutorial_menu_submenu_help_body">Găsește documentația, termenii și condițiile, jurnalul modificărilor și redă din nou acest tutorial.</string>
