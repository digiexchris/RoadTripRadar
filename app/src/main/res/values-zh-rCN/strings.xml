    <!-- Location permission dialog -->
    <string name="permission_location_title">需要位置权限</string>
    <string name="permission_location_body">Road Trip Radar 需要访问您的位置，以便在地图上显示您所在的位置。为获得最佳精度，建议使用精确位置，但大致位置也可以正常工作。点击“授予权限”以继续，或点击“退出”以关闭应用。</string>
    <string name="permission_grant">授予权限</string>
    <string name="permission_location_denied_title">需要位置权限</string>
    <string name="permission_location_denied_body">Road Trip Radar 旨在在您驾驶时显示您周围的区域，因此如果没有位置访问权限则无法运行。应用现在将退出。您可以在系统“设置”中启用位置权限，然后重新启动应用。</string>
