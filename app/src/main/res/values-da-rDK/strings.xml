    <!-- Tutorial: MAP group -->
    <string name="tutorial_map_welcome_title">Velkommen til Road Trip Radar</string>
    <string name="tutorial_map_welcome_body">En hurtig rundtur i kortets kontroller. Knib for at zoome, træk op eller ned med to fingre for at vippe kortet, og drej med to fingre for at rotere det.</string>
    <string name="tutorial_map_speed_title">Speedometer</string>
    <string name="tutorial_map_speed_body">Din aktuelle hastighed, vist når GPS har signal. Skift mellem km/t og mph i menuen Systemindstillinger.</string>
    <string name="tutorial_map_compass_title">Kompas</string>
    <string name="tutorial_map_compass_body">Tryk én gang for at låse kortet med nord opad. Tryk igen for at rotere kortet, så det følger din retning.</string>
    <string name="tutorial_map_drop_pin_title">Sæt en nål</string>
    <string name="tutorial_map_drop_pin_body">Tryk og hold hvor som helst på kortet for at sætte en nål og navigere mod den.</string>
    <string name="tutorial_map_zoom_out_title">Zoom ud</string>
    <string name="tutorial_map_zoom_out_body">Tryk for at zoome ud. Du kan også knibe på kortet med to fingre.</string>
    <string name="tutorial_map_zoom_in_title">Zoom ind</string>
    <string name="tutorial_map_zoom_in_body">Tryk for at zoome ind. Du kan også sprede to fingre fra hinanden på kortet.</string>
    <string name="tutorial_map_weather_title">Vejrradar</string>
    <string name="tutorial_map_weather_body">Tryk for at afspille eller sætte radaranimationen på pause. Tryk og hold for at slå radaren helt fra.</string>
    <string name="tutorial_map_menu_title">Menu for hurtige handlinger</string>
    <string name="tutorial_map_menu_body">Åbner panelet med hurtige handlinger med indstillinger, temaer og interessepunkter.</string>
    <!-- Tutorial: MENU_MAIN group -->
    <string name="tutorial_menu_weather_toggle_title">Vejrradar</string>
    <string name="tutorial_menu_weather_toggle_body">Slå vejrradar-overlejringen til eller fra.</string>
    <string name="tutorial_menu_north_up_title">Nord op</string>
    <string name="tutorial_menu_north_up_body">Lås kortet, så nord altid er opad, eller lad det rotere, så det følger din retning.</string>
    <string name="tutorial_menu_nearby_places_title">Steder i nærheden</string>
    <string name="tutorial_menu_nearby_places_body">Vælg, hvilke kategorier af interessepunkter (brændstof, mad, overnatning osv.) der skal indlæses på kortet.</string>
    <string name="tutorial_menu_location_search_title">Søg efter sted</string>
    <string name="tutorial_menu_location_search_body">Søg efter en adresse eller et stednavn inden for det synlige kortområde.</string>
    <string name="tutorial_menu_submenu_map_title">Kort-undermenu</string>
    <string name="tutorial_menu_submenu_map_body">Vælg et korttema, og juster kortrelaterede indstillinger som f.eks. midterforskydning.</string>
    <string name="tutorial_menu_submenu_weather_title">Vejr-undermenu</string>
    <string name="tutorial_menu_submenu_weather_body">Slå vind-/temperatur-widget, radarlegend og tidslinje til eller fra, og juster radarens opacitet og enheder.</string>
    <string name="tutorial_menu_submenu_system_title">System-undermenu</string>
    <string name="tutorial_menu_submenu_system_body">Skift sprog, widgetstørrelser, enheder, skærmadfærd, og nulstil til standardindstillingerne.</string>
    <string name="tutorial_menu_submenu_help_title">Hjælp &amp; info</string>
    <string name="tutorial_menu_submenu_help_body">Find dokumentation, vilkår og betingelser, ændringsloggen, og afspil denne vejledning igen.</string>
