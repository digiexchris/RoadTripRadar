    <!-- Location permission dialog -->
    <string name="permission_location_title">Placeringstilladelse påkrævet</string>
    <string name="permission_location_body">Road Trip Radar har brug for adgang til din placering for at vise, hvor du er på kortet. Præcis placering anbefales for bedst mulig nøjagtighed, men omtrentlig placering fungerer også. Tryk på Giv tilladelse for at fortsætte eller Afslut for at lukke appen.</string>
    <string name="permission_grant">Giv tilladelse</string>
    <string name="permission_location_denied_title">Placering påkrævet</string>
    <string name="permission_location_denied_body">Road Trip Radar er designet til at vise området omkring dig, mens du kører, så den kan ikke fungere uden adgang til placering. Appen lukkes nu. Du kan aktivere adgang til placering i systemindstillingerne og starte appen igen.</string>
