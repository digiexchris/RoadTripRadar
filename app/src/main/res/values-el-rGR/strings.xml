    <!-- Location permission dialog -->
    <string name="permission_location_title">Απαιτείται άδεια τοποθεσίας</string>
    <string name="permission_location_body">Το Road Trip Radar χρειάζεται πρόσβαση στην τοποθεσία σας για να δείχνει πού βρίσκεστε στον χάρτη. Για βέλτιστη ακρίβεια συνιστάται η ακριβής τοποθεσία, αλλά λειτουργεί και η κατά προσέγγιση τοποθεσία. Πατήστε \"Παραχώρηση άδειας\" για να συνεχίσετε ή \"Έξοδος\" για να κλείσετε την εφαρμογή.</string>
    <string name="permission_grant">Παραχώρηση άδειας</string>
    <string name="permission_location_denied_title">Απαιτείται τοποθεσία</string>
    <string name="permission_location_denied_body">Το Road Trip Radar έχει σχεδιαστεί για να εμφανίζει την περιοχή γύρω σας ενώ οδηγείτε, επομένως δεν μπορεί να λειτουργήσει χωρίς πρόσβαση στην τοποθεσία. Η εφαρμογή θα κλείσει τώρα. Μπορείτε να ενεργοποιήσετε την πρόσβαση στην τοποθεσία από τις Ρυθμίσεις συστήματος και να ανοίξετε ξανά την εφαρμογή.</string>
