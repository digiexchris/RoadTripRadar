    <!-- Tutorial: MAP group -->
    <string name="tutorial_map_welcome_title">Καλώς ορίσατε στο Road Trip Radar</string>
    <string name="tutorial_map_welcome_body">Μια σύντομη περιήγηση στα στοιχεία ελέγχου του χάρτη. Τσιμπήστε για μεγέθυνση, σύρετε με δύο δάχτυλα προς τα πάνω ή προς τα κάτω για να γείρετε τον χάρτη και περιστρέψτε δύο δάχτυλα για να τον στρέψετε.</string>
    <string name="tutorial_map_speed_title">Ταχύμετρο</string>
    <string name="tutorial_map_speed_body">Η τρέχουσα ταχύτητά σας, που εμφανίζεται όταν το GPS έχει σήμα. Εναλλάξτε μεταξύ km/h και mph στο μενού ρυθμίσεων Συστήματος.</string>
    <string name="tutorial_map_compass_title">Πυξίδα</string>
    <string name="tutorial_map_compass_body">Πατήστε μία φορά για να κλειδώσετε τον χάρτη με τον Βορρά προς τα πάνω. Πατήστε ξανά για να περιστρέφεται ο χάρτης σύμφωνα με την πορεία σας.</string>
    <string name="tutorial_map_drop_pin_title">Τοποθέτηση πινέζας</string>
    <string name="tutorial_map_drop_pin_body">Πατήστε παρατεταμένα οπουδήποτε στον χάρτη για να τοποθετήσετε μια πινέζα και να πλοηγηθείτε προς αυτήν.</string>
    <string name="tutorial_map_zoom_out_title">Σμίκρυνση</string>
    <string name="tutorial_map_zoom_out_body">Πατήστε για σμίκρυνση. Μπορείτε επίσης να τσιμπήσετε τον χάρτη με δύο δάχτυλα.</string>
    <string name="tutorial_map_zoom_in_title">Μεγέθυνση</string>
    <string name="tutorial_map_zoom_in_body">Πατήστε για μεγέθυνση. Μπορείτε επίσης να ανοίξετε δύο δάχτυλα πάνω στον χάρτη.</string>
    <string name="tutorial_map_weather_title">Ραντάρ καιρού</string>
    <string name="tutorial_map_weather_body">Πατήστε για αναπαραγωγή ή παύση της κίνησης του ραντάρ. Πατήστε παρατεταμένα για να απενεργοποιήσετε εντελώς το ραντάρ.</string>
    <string name="tutorial_map_menu_title">Μενού γρήγορων ενεργειών</string>
    <string name="tutorial_map_menu_body">Ανοίγει το συρτάρι γρήγορων ενεργειών με ρυθμίσεις, θέματα και σημεία ενδιαφέροντος.</string>
    <!-- Tutorial: MENU_MAIN group -->
    <string name="tutorial_menu_weather_toggle_title">Ραντάρ καιρού</string>
    <string name="tutorial_menu_weather_toggle_body">Ενεργοποιήστε ή απενεργοποιήστε το επίπεδο επικάλυψης του ραντάρ καιρού.</string>
    <string name="tutorial_menu_north_up_title">Βορράς προς τα πάνω</string>
    <string name="tutorial_menu_north_up_body">Κλειδώστε τον χάρτη ώστε ο Βορράς να είναι πάντα προς τα πάνω ή αφήστε τον να περιστρέφεται σύμφωνα με την πορεία σας.</string>
    <string name="tutorial_menu_nearby_places_title">Κοντινά μέρη</string>
    <string name="tutorial_menu_nearby_places_body">Επιλέξτε ποιες κατηγορίες σημείων ενδιαφέροντος (καύσιμα, φαγητό, διαμονή κ.λπ.) θα φορτωθούν στον χάρτη.</string>
    <string name="tutorial_menu_location_search_title">Αναζήτηση τοποθεσίας</string>
    <string name="tutorial_menu_location_search_body">Αναζητήστε μια διεύθυνση ή ένα όνομα τοποθεσίας μέσα στην ορατή περιοχή του χάρτη.</string>
    <string name="tutorial_menu_submenu_map_title">Υπομενού χάρτη</string>
    <string name="tutorial_menu_submenu_map_body">Επιλέξτε ένα θέμα χάρτη και προσαρμόστε ρυθμίσεις σχετικές με τον χάρτη, όπως τη μετατόπιση κέντρου.</string>
    <string name="tutorial_menu_submenu_weather_title">Υπομενού καιρού</string>
    <string name="tutorial_menu_submenu_weather_body">Εναλλάξτε το γραφικό στοιχείο ανέμου/θερμοκρασίας, τον υπόμνημα ραντάρ και τη χρονογραμμή, και προσαρμόστε την αδιαφάνεια και τις μονάδες του ραντάρ.</string>
    <string name="tutorial_menu_submenu_system_title">Υπομενού συστήματος</string>
    <string name="tutorial_menu_submenu_system_body">Αλλάξτε γλώσσα, μεγέθη γραφικών στοιχείων, μονάδες, συμπεριφορά οθόνης και επαναφέρετε τις προεπιλογές.</string>
    <string name="tutorial_menu_submenu_help_title">Βοήθεια &amp; Πληροφορίες</string>
    <string name="tutorial_menu_submenu_help_body">Βρείτε την τεκμηρίωση, τους όρους και τις προϋποθέσεις, το αρχείο αλλαγών και επαναλάβετε αυτό το σεμινάριο.</string>
