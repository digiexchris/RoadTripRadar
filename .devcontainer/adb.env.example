# Copy this file to .devcontainer/adb.env and fill in your values.
# The adb.env file is gitignored and will not be committed.

# Devices to try, in order of preference. One per line.
# Wi-Fi devices use ip:port format, USB devices use their serial number.
# Run 'adb devices -l' to find serial numbers of connected USB devices.
ADB_DEVICES=(
    192.168.1.100:5555
    # ABCD1234
)
